{
  "name": "cliptap",
  "version": "1.0.0",
  "description": "Ctrl+Shift+V — Clipboard manager for Windows",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "start": "electron .",
    "test": "vitest run",
    "lint": "eslint src tests scripts build.js",
    "format": "prettier --write src tests scripts build.js",
    "verify-release": "node scripts/verify-release.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron": "^44.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "vitest": "^2.1.0"
  }
}
